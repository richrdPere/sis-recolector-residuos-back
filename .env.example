NODE_ENV=development
PORT=4000

# MYSQL
DB_DIALECT=mysql
DB_HOST=localhost  # 127.0.0.1
DB_PORT=3306
DB_NAME=sis_recoleccion_residuos
DB_USER=root  # recoleccion_app
DB_PASSWORD=root  # 506899pereiR@

# AUTENTICACIÓN
JWT_ACCESS_SECRET=a9b7c5d3e1
JWT_REFRESH_SECRET=a9b7c5d3e1
JWT_ACCESS_EXPIRES=30m  #1h # 8h
JWT_REFRESH_EXPIRES=7d  # 30d

# DIRECCIONES PÚBLICAS
FRONTEND_URL=http://localhost:4200  # FRONTEND_URL=https://recoleccion-calca-pruebas.duckdns.org
SOCKET_CORS_ORIGINS=http://localhost:4200  # SOCKET_CORS_ORIGINS=https://recoleccion-calca-pruebas.duckdns.org
PUBLIC_WEB_URL=http://localhost:4200 # PUBLIC_WEB_URL=https://recoleccion-calca-pruebas.duckdns.org
QR_HASH_SECRET=b6b8a92974bd00f036dae1f9b511b1e0b057915c937d45fc2beaad690a63e7d1

# ARCHIVOS
UPLOADS_DIR=/var/www/recoleccion/uploads
MAX_FILE_SIZE=10485760

# FIREBASE
FIREBASE_PROJECT_ID=sis-recoleccion-residuos
FIREBASE_CREDENTIALS_PATH=cert/firebase-admin.json
FCM_ANDROID_CHANNEL_ID=recoleccion_alertas

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_MAX_BATCHES=3
NOTIFICATION_MAX_ATTEMPTS=3

PUBLIC_LOCATION_MAX_AGE_SECONDS=120
PUBLIC_LOCATION_DECIMALS=3

# TRACKING 
GPS_MOVING_INTERVAL_SECONDS=15

# Velocidad de referencia durante el desplazamiento.
ETA_VELOCIDAD_KMH=8

# Tiempo estimado por parada pendiente antes del destino.
ETA_MINUTOS_PARADA=1

# Distancia máxima entre domicilio y punto de recolección.
ETA_RADIO_DOMICILIO_METROS=200

GOOGLE_APPLICATION_CREDENTIALS=/var/www/recoleccion/secrets/firebase-admin.json