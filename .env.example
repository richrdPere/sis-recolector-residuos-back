FIREBASE_PROJECT_ID=sis-recoleccion-residuos
FIREBASE_CREDENTIALS_PATH=cert/firebase-admin.json
FCM_ANDROID_CHANNEL_ID=recoleccion_alertas

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_MAX_BATCHES=3
NOTIFICATION_MAX_ATTEMPTS=3



PUBLIC_LOCATION_MAX_AGE_SECONDS=120
PUBLIC_LOCATION_DECIMALS=3

# Velocidad de referencia durante el desplazamiento.
ETA_VELOCIDAD_KMH=8

# Tiempo estimado por parada pendiente antes del destino.
ETA_MINUTOS_PARADA=1

# Distancia máxima entre domicilio y punto de recolección.
ETA_RADIO_DOMICILIO_METROS=200


GOOGLE_APPLICATION_CREDENTIALS=/var/www/recoleccion/secrets/firebase-admin.json