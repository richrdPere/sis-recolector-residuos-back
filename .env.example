FRONTEND_URL=http://localhost:4200  #PUBLIC_WEB_URL=https://recoleccion-calca-pruebas.duckdns.org
PUBLIC_WEB_URL=http://localhost:4200 #PUBLIC_WEB_URL=https://recoleccion-calca-pruebas.duckdns.org
QR_HASH_SECRET=reemplazar-por-una-cadena-larga-y-aleatoria

# Archivos
UPLOADS_DIR=/var/www/recoleccion/uploads
